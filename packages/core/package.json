{
  "name": "@zupfnoter/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./commands": {
      "source": "./src/commands.ts",
      "import": "./dist/commands.js",
      "types": "./dist/commands.d.ts"
    },
    "./legacyCommands": {
      "source": "./src/legacyCommands.ts",
      "import": "./dist/legacyCommands.js",
      "types": "./dist/legacyCommands.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:dump:song": "pnpm --dir ../.. exec vitest run packages/core/src/testing/__tests__/song/dump_ts_output.spec.ts --reporter=verbose",
    "test:dump:sheet": "pnpm --dir ../.. exec vitest run packages/core/src/testing/__tests__/sheet/dump_ts_output.spec.ts --reporter=verbose",
    "test:dump:svg": "pnpm --dir ../.. exec vitest run packages/core/src/testing/__tests__/output_svg/dump_ts_output.spec.ts --reporter=verbose",
    "test:dump:pdf": "pnpm --dir ../.. exec vitest run packages/core/src/testing/__tests__/output_pdf/dump_ts_output.spec.ts --reporter=verbose",
    "test:pdf-parity": "ZUPFNOTER_PDF_PARITY=1 pnpm --dir ../.. run test:core -- src/testing/__tests__/pdf/legacy_comparison.spec.ts --reporter=verbose",
    "test:full": "pnpm run test:unit && pnpm run test:gaps",
    "test:gaps": "ZUPFNOTER_GAP_REPORTS=1 pnpm --dir ../.. exec vitest run packages/core/src/testing/__tests__/song/gap_report.spec.ts packages/core/src/testing/__tests__/sheet/gap_report.spec.ts packages/core/src/testing/__tests__/output_svg/gap_report.spec.ts --reporter=verbose",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test:unit": "pnpm --dir ../.. run test:core",
    "test:ui": "pnpm --dir ../.. run test:core -- --ui",
    "lint": "oxlint --ignore-path .oxlintignore ."
  },
  "dependencies": {
    "@zupfnoter/types": "workspace:*",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@types/jpeg-js": "^0.3.7",
    "@types/qrcode": "^1.5.5",
    "oxlint": "~1.50.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
