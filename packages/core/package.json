{
  "name": "@zupfnoter/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:dump:song": "vitest run src/testing/__tests__/song/dump_ts_output.spec.ts --reporter=verbose",
    "test:dump:sheet": "vitest run src/testing/__tests__/sheet/dump_ts_output.spec.ts --reporter=verbose",
    "test:dump:svg": "vitest run src/testing/__tests__/output_svg/dump_ts_output.spec.ts --reporter=verbose",
    "test:full": "pnpm run test:unit && pnpm run test:gaps",
    "test:gaps": "vitest run src/testing/__tests__/song/gap_report.spec.ts src/testing/__tests__/sheet/gap_report.spec.ts src/testing/__tests__/output_svg/gap_report.spec.ts --reporter=verbose",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "test:unit": "vitest",
    "lint": "oxlint --ignore-path .oxlintignore ."
  },
  "dependencies": {
    "@zupfnoter/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "oxlint": "~1.50.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
