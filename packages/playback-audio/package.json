{
  "name": "@zupfnoter/playback-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./session": {
      "source": "./src/AudioSession.ts",
      "types": "./dist/AudioSession.d.ts",
      "import": "./dist/AudioSession.js"
    },
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@zupfnoter/core": "workspace:*",
    "@zupfnoter/playback": "workspace:*",
    "@zupfnoter/types": "workspace:*",
    "soundfont-player": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
