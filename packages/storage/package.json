{
  "name": "@zupfnoter/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "pnpm --dir ../.. exec vitest run packages/storage/src/__tests__",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@zupfnoter/core": "workspace:*",
    "@zupfnoter/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
